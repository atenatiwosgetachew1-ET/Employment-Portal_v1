# Django Configuration
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Option A (Local PostgreSQL):
DB_NAME=employment_portal_db
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=127.0.0.1
DB_PORT=5432

# Option B (Local SQLite - quick dev without PostgreSQL service):
# USE_SQLITE=true

# Option C (Production Neon PostgreSQL / Render):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Email Configuration (Gmail SMTP)
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=yourgmail@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Links in verification / password-reset emails (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Production Cookie Security Settings (set true when serving over HTTPS)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# Company Control Center Integration
COMPANY_CONTROL_CENTER_BASE_URL=
COMPANY_CONTROL_CENTER_BOOTSTRAP_LOGIN_URL=
COMPANY_CONTROL_CENTER_BOOTSTRAP_SHARED_SECRET=
COMPANY_CONTROL_CENTER_BOOTSTRAP_TIMEOUT_SECONDS=10

# Employee PaddleOCR Service
EMPLOYEE_OCR_SERVICE_URL=http://127.0.0.1:8766
EMPLOYEE_OCR_SERVICE_TIMEOUT_SECONDS=60

# Travel Provider Service
TRAVEL_SERVICE_URL=http://127.0.0.1:8001
TRAVEL_SERVICE_TIMEOUT_SECONDS=30
TRAVEL_SERVICE_STATUS_PATH=/health
TRAVEL_SERVICE_AUTH_PATH=/api/auth/service-token
TRAVEL_SERVICE_FLIGHT_SEARCH_PATH=/api/flights/search
TRAVEL_SERVICE_LOCATION_SEARCH_PATH=/api/locations/search
TRAVEL_SERVICE_CLIENT_ID=employment-portal
TRAVEL_SERVICE_CLIENT_SECRET=change-employment-portal-secret
TRAVEL_SERVICE_SOURCE_SYSTEM=employment_portal
